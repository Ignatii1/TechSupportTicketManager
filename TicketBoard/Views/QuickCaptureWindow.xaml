<ui:FluentWindow x:Class="TicketBoard.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:TicketBoard.Converters"
        Title="Быстрое добавление"
        Width="480" MinWidth="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FontUi}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnKeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEq" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </ui:FluentWindow.Resources>

    <Border BorderBrush="{DynamicResource WinBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <!-- окно бывает выше содержимого (WPF прибавляет высоту заголовка) — пустота уходит сюда, а не под футер -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- шапка -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <ContentControl DockPanel.Dock="Right" Style="{StaticResource Kbd}" Content="Esc" />
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Path Data="{StaticResource AppGlyph}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.25"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock Style="{StaticResource Caption}" Text="Быстрое добавление" Margin="8,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <!-- поле -->
            <ui:TextBox x:Name="Input" Grid.Row="1" Height="36" FontSize="14" Padding="12,0"
                        PlaceholderText="Вставьте ссылку из Интрасервиса или введите название"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

            <!-- распознано / подсказка · приоритет -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Visibility="{Binding HasNumber, Converter={StaticResource BoolToVis}}">
                    <Border Height="24" Padding="8,0" CornerRadius="4" Background="{DynamicResource AccentTint}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark12" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NumberText}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Preview}" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding Preview}" />
                </StackPanel>
                <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasNumber, Converter={StaticResource InvBoolToVis}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <RadioButton Style="{StaticResource PrioLow}"  GroupName="QuickPrio" Padding="6,0,8,0" Margin="0,0,2,0" IsChecked="{Binding Priority, Converter={StaticResource EnumEq}, ConverterParameter=Low}">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Kbd}" Content="1" Margin="0,0,5,0" /><TextBlock Text="Низкий" FontSize="12" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PrioMid}"  GroupName="QuickPrio" Padding="6,0,8,0" Margin="0,0,2,0" IsChecked="{Binding Priority, Converter={StaticResource EnumEq}, ConverterParameter=Mid}">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Kbd}" Content="2" Margin="0,0,5,0" /><TextBlock Text="Средний" FontSize="12" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PrioHigh}" GroupName="QuickPrio" Padding="6,0,8,0" IsChecked="{Binding Priority, Converter={StaticResource EnumEq}, ConverterParameter=High}">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Kbd}" Content="3" Margin="0,0,5,0" /><TextBlock Text="Высокий" FontSize="12" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- футер -->
            <DockPanel Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Bottom">
                <TextBlock DockPanel.Dock="Right" FontSize="11" LineHeight="16" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center">
                    <Run Text="Глобальный хоткей: " /><Run Text="{Binding HotkeyText, Mode=OneWay}" />
                </TextBlock>
                <ContentControl Style="{StaticResource Kbd}" Content="Enter" />
                <TextBlock FontSize="11" LineHeight="16" Foreground="{DynamicResource TextTertiary}" Text="во «Входящие»" Margin="6,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
