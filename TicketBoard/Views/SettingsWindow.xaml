<ui:FluentWindow x:Class="TicketBoard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:TicketBoard.Converters"
        Title="Настройки"
        Width="560" Height="720" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FontUi}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnKeyDown">

    <ui:FluentWindow.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrong}">
            <Setter Property="Margin" Value="0,24,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- ошибка под полем: пустая строка — не видно -->
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource CriticalFg}" />
            <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVis}}" />
        </Style>
        <Style x:Key="FieldNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTertiary}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="48" Title="Настройки" FontSize="12" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,20">

                <!-- ===== Быстрое добавление ===== -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Быстрое добавление" Margin="0,4,0,0" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Глобальный хоткей" />
                <ui:TextBox PlaceholderText="Ctrl+Alt+Space" Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding HotkeyError}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Номер заявки в ссылке — регулярка, группа 1 = номер" />
                <ui:TextBox FontFamily="{StaticResource FontMono}" Text="{Binding IdPattern, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding IdPatternError}" />
                <TextBlock Style="{StaticResource FieldNote}" Text="Не совпало — берётся последнее число в ссылке." />

                <!-- ===== Доска ===== -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Доска" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Скрывать «Готово» старше, дней" />
                        <ui:TextBox Text="{Binding HideDoneDays, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding HideDoneDaysError}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Лимит «В работе»" />
                        <ui:TextBox Text="{Binding WipLimit, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding WipLimitError}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Просрочена через, дней" />
                        <ui:TextBox Text="{Binding OverdueDays, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding OverdueDaysError}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldNote}" Text="За день до просрочки карточка желтеет. «Готово» не подсвечивается." />

                <!-- ===== API Интрасервиса ===== -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="API Интрасервиса" />
                <TextBlock Style="{StaticResource FieldNote}" Text="Название и статус заявки подтягиваются по номеру. Пустой адрес — API выключен." />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес" />
                <ui:TextBox PlaceholderText="https://helpdesk.company.ru" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding BaseUrlError}" />
                <TextBlock Style="{StaticResource FieldError}" Foreground="{DynamicResource CautionFg}" Text="{Binding BaseUrlWarning}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Логин" />
                        <ui:TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль" />
                        <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="{Binding PasswordPlaceholder}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldNote}" Text="У API Интрасервиса только вход по логину и паролю. Пароль хранится зашифрованным (Windows DPAPI) — прочитать его может только ваша учётная запись." />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button x:Name="CheckButton" Content="Проверить подключение" Click="OnCheck" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding CheckResult}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== футер ===== -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <ui:Button Content="Отмена" MinWidth="96" Margin="0,0,8,0" Click="OnCancel" />
                    <ui:Button Appearance="Primary" Content="Сохранить" MinWidth="96" Click="OnSave" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldError}" Margin="0" Text="{Binding SaveError}" />
                    <TextBlock Style="{StaticResource CaptionTertiary}" Text="Применяется сразу после сохранения." TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
