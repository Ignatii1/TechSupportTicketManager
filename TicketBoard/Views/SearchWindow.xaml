<ui:FluentWindow x:Class="TicketBoard.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:TicketBoard.Converters"
        xmlns:vm="clr-namespace:TicketBoard.ViewModels"
        Title="Поиск в Интрасервисе"
        Width="560" Height="620" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FontUi}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnKeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />

        <!-- строка результата и чип статуса — только здесь: общие стили правит соседняя ветка -->
        <Style x:Key="ResultRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="48" Title="Поиск в Интрасервисе" FontSize="12" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- запрос: фокус всегда здесь, Enter повторяет поиск -->
        <ui:TextBox x:Name="QueryBox" Grid.Row="1" Margin="16,0,16,0" Height="36" FontSize="14" Padding="12,0"
                    PlaceholderText="Слово из заявки или из её комментариев"
                    Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

        <!-- состояние: полоска «идёт запрос» + одна строка текста -->
        <StackPanel Grid.Row="2" Margin="16,8,16,8">
            <Border Height="2" CornerRadius="1" Margin="0,0,0,6" Background="{DynamicResource Accent}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBox Style="{StaticResource SelectableText}" Foreground="{DynamicResource TextSecondary}" Text="{Binding Message, Mode=OneWay}"
                     Visibility="{Binding Message, Converter={StaticResource StringToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- отступы на ItemsControl, а не Padding у ScrollViewer: не зависим от шаблона контрола -->
            <ItemsControl ItemsSource="{Binding Results}" Margin="16,0,16,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FoundTicketViewModel}">
                        <Border Style="{StaticResource ResultRow}" MouseLeftButtonDown="OnRowClick"
                                Opacity="{Binding OnBoard, Converter={StaticResource BoolToOpacity}, ConverterParameter=0.5}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Mono12}" Text="{Binding DisplayNumber}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource ResultChip}" Margin="8,0,0,0"
                                                Visibility="{Binding Status, Converter={StaticResource StringToVis}}">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Title}" ToolTip="{Binding Title}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding Creator}" ToolTip="{Binding Creator}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                   Visibility="{Binding Creator, Converter={StaticResource StringToVis}}" />
                                        <TextBlock Style="{StaticResource CaptionTertiary}" Text="{Binding Created}" Margin="8,0,0,0"
                                                   Visibility="{Binding Created, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource CardOpenButton}" Content="↗" FontSize="14"
                                            VerticalAlignment="Center" ToolTip="Открыть в браузере"
                                            Visibility="{Binding Url, Converter={StaticResource StringToVis}}"
                                            Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}" />
                                    <ui:Button Content="+ На доску" FontSize="12" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Добавить во «Входящие»"
                                               Visibility="{Binding OnBoard, Converter={StaticResource InvBoolToVis}}"
                                               Command="{Binding DataContext.AddToBoardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource CaptionTertiary}" Text="уже на доске" Margin="8,0,2,0" VerticalAlignment="Center"
                                               Visibility="{Binding OnBoard, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- футер -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Center"
                           Text="Ищет и по тексту комментариев" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Kbd}" Content="Enter" />
                    <TextBlock Style="{StaticResource CaptionTertiary}" Text="искать" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource Kbd}" Content="Esc" Margin="12,0,0,0" />
                    <TextBlock Style="{StaticResource CaptionTertiary}" Text="закрыть" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
