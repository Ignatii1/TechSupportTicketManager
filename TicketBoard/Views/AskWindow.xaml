<ui:FluentWindow x:Class="TicketBoard.Views.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Заявки"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FontUi}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnKeyDown">

    <!-- вопрос или сообщение вместо системного MessageBox: те же токены, шрифт и кнопки, что у остальных окон -->
    <Border BorderBrush="{DynamicResource WinBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- окно бывает выше содержимого (WPF прибавляет высоту заголовка) — пустота уходит сюда, а не под футер -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource Subtitle}" Margin="24,20,24,0" />

            <!-- длинный текст (список заявок, ответ сервера) прокручивается, его можно выделить и скопировать -->
            <ScrollViewer Grid.Row="1" MaxHeight="360" Margin="24,8,24,20"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="MessageText" Style="{StaticResource SelectableText}"
                         FontSize="14" Foreground="{DynamicResource TextSecondary}" />
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="NoButton" MinWidth="96" Margin="0,0,8,0" Click="OnNo" />
                    <ui:Button x:Name="YesButton" Appearance="Primary" MinWidth="96" IsDefault="True" Click="OnYes" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
