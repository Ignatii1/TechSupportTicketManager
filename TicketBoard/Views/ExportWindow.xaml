<ui:FluentWindow x:Class="TicketBoard.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:TicketBoard.Converters"
        Title="Выгрузка для базы знаний"
        Width="560" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FontUi}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnKeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEq" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="48" Title="Выгрузка для базы знаний" FontSize="12" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,20">
                <TextBlock Style="{StaticResource FieldNote}" Margin="0"
                           Text="Заявки из Интрасервиса — файлами Markdown: по файлу на заявку, с описанием и всей перепиской, в формате для Obsidian и для агента, который разберёт их в базу знаний. Повторная выгрузка перепишет только изменившиеся заявки." />

                <!-- ===== Какие заявки ===== -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Какие заявки" />
                <CheckBox Margin="0,12,0,0" Content="Мои — где я исполнитель" IsChecked="{Binding Mine}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Слова" />
                <ui:TextBox PlaceholderText="Например: принтер замятие" Text="{Binding Words, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldNote}" Text="Ищет Интрасервис — в полях заявки и во всех её комментариях. Пусто — без слов (тогда нужны «Мои»)." />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Статус" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="ExportStatus" Content="Закрытые" Margin="0,0,16,0"
                                 IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=Closed}" />
                    <RadioButton GroupName="ExportStatus" Content="Открытые" Margin="0,0,16,0"
                                 IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=Open}" />
                    <RadioButton GroupName="ExportStatus" Content="Все"
                                 IsChecked="{Binding Status, Converter={StaticResource EnumEq}, ConverterParameter=All}" />
                </StackPanel>
                <TextBlock Style="{StaticResource FieldNote}" Text="Решение обычно в закрытых. Закрытые — по признакам статуса и списку ClosedStatusNames, как у F5." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="За последние, дней" />
                        <ui:TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                        <TextBlock Style="{StaticResource FieldNote}" Text="По дате изменения; 0 — за всё время" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Не больше, заявок" />
                        <ui:TextBox Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                        <TextBlock Style="{StaticResource FieldNote}" Text="Свежие первыми" />
                    </StackPanel>
                </Grid>

                <!-- ===== Куда ===== -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Куда" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Папка" />
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Открыть" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
                    <ui:Button DockPanel.Dock="Right" Content="Выбрать…" Margin="8,0,0,0" Click="OnChooseFolder" />
                    <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                </DockPanel>
                <TextBlock Style="{StaticResource FieldNote}" Text="Внутри — папка tickets (файл на заявку) и оглавление _index.md. Можно выбрать папку в хранилище Obsidian." />

                <!-- ===== Выгрузка ===== -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <ui:Button Appearance="Primary" Content="Выгрузить" Command="{Binding ExportCommand}" />
                    <ui:Button Content="Остановить" Margin="8,0,0,0" Command="{Binding StopCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Border Height="2" CornerRadius="1" Margin="0,12,0,0" Background="{DynamicResource Accent}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBox Style="{StaticResource SelectableText}" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"
                         Text="{Binding Message, Mode=OneWay}" Visibility="{Binding Message, Converter={StaticResource StringToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- футер -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Center"
                           Text="Телефоны и почта людей не выгружаются" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Kbd}" Content="Esc" />
                    <TextBlock Style="{StaticResource CaptionTertiary}" Text="закрыть (выгрузка продолжится)" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
