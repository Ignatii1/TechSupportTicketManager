<ui:FluentWindow x:Class="TicketBoard.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:TicketBoard.Converters"
        xmlns:vm="clr-namespace:TicketBoard.ViewModels"
        Title="Заявки"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FontUi}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnKeyDown">

    <!-- «Сменить статус заявки #N?» при переносе карточки (этап 8, шаг 2): всё, что уйдёт, — на виду; данные и правила —
         StatusForm. «Сменить статус» — только щелчком: Enter в поле комментария — новая строка -->
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </ui:FluentWindow.Resources>

    <Border BorderBrush="{DynamicResource WinBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Subtitle}" Margin="24,20,24,0" Text="{Binding Heading}" />

            <ScrollViewer Grid.Row="1" MaxHeight="560" Margin="24,8,24,16"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource CaptionTertiary}" Margin="0,4,0,0"
                               Text="{Binding Current, StringFormat='Сейчас в Интрасервисе: «{0}»'}" />

                    <!-- последние комментарии: не закрыть заявку, на которую только что ответили -->
                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="Последнее в переписке" />
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CommentRow}">
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Style="{StaticResource CaptionTertiary}">
                                            <Run Text="{Binding Author, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Date, Mode=OneWay, StringFormat='dd.MM HH:mm'}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="Новый статус" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Target}" DisplayMemberPath="Name" />
                    <TextBlock Style="{StaticResource FieldNote}" TextWrapping="Wrap" Text="{Binding Note}"
                               Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="{Binding CommentHint}" />
                    <ui:TextBox x:Name="CommentBox" MinHeight="64" MaxHeight="160" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,8,0,0" Content="Внутренний (видят только сотрудники)" IsChecked="{Binding Internal}" />
                    <TextBlock Style="{StaticResource FieldNote}" Text="{Binding KindText}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button MinWidth="120" Margin="0,0,8,0" Content="Только на доске" Click="OnBoardOnly" />
                    <ui:Button MinWidth="120" Appearance="Primary" Content="Сменить статус" IsEnabled="{Binding CanApply}" Click="OnApply" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
