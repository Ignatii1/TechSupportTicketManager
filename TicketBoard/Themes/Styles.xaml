<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:TicketBoard.Models">

    <!-- ===== Типографика ===== -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Cascadia Mono</FontFamily>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style x:Key="CaptionTertiary" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Mono12" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Глиф приложения (16×16): планшет заявки с двумя строками и галочкой -->
    <Geometry x:Key="AppGlyph">M4,2.5 H12 A2,2 0 0 1 14,4.5 V11.5 A2,2 0 0 1 12,13.5 H4 A2,2 0 0 1 2,11.5 V4.5 A2,2 0 0 1 4,2.5 Z M5,6 H11 M5,8.5 H9 M9.5,11.5 L10.7,12.7 L13,10.3</Geometry>

    <!-- ===== kbd — подсказка клавиши ===== -->
    <Style x:Key="Kbd" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Height="16" Padding="5,0" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeBottom}" SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="11" LineHeight="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiary}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- kbd на акцентной кнопке: цвет текста кнопки, opacity .7 -->
    <Style x:Key="KbdOnAccent" TargetType="ContentControl" BasedOn="{StaticResource Kbd}">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Height="16" Padding="5,0" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="11" LineHeight="14" FontWeight="Normal" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Иконочная кнопка 32×32 / 24×24 (subtle) ===== -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CardOpenButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Счётчик колонки (pill 20) ===== -->
    <Style x:Key="CountPill" TargetType="Border">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOverloaded}" Value="True">
                <Setter Property="Background" Value="{DynamicResource CautionBg}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionFg}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Бейдж возраста (pill 16) — цвет по AgeState заявки ===== -->
    <Style x:Key="AgeBadge" TargetType="Border">
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AgeState}" Value="{x:Static m:AgeState.Warn}">
                <Setter Property="Background" Value="{DynamicResource CautionBg}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionFg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AgeState}" Value="{x:Static m:AgeState.Overdue}">
                <Setter Property="Background" Value="{DynamicResource CriticalBg}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalFg}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Чип приоритета (18, радиус 4) ===== -->
    <Style x:Key="PriorityChip" TargetType="Border">
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Priority}" Value="{x:Static m:TicketPriority.Mid}">
                <Setter Property="Background" Value="{DynamicResource CautionBg}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionFg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Priority}" Value="{x:Static m:TicketPriority.High}">
                <Setter Property="Background" Value="{DynamicResource CriticalBg}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalFg}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Сегмент приоритета: RadioButton 24px ===== -->
    <Style x:Key="PrioSegBase" TargetType="RadioButton">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBottom}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrioLow" TargetType="RadioButton" BasedOn="{StaticResource PrioSegBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PrioMid" TargetType="RadioButton" BasedOn="{StaticResource PrioSegBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource CautionBg}" />
                <Setter Property="Foreground" Value="{DynamicResource CautionFg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CautionFg}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PrioHigh" TargetType="RadioButton" BasedOn="{StaticResource PrioSegBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource CriticalBg}" />
                <Setter Property="Foreground" Value="{DynamicResource CriticalFg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CriticalFg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Карточка заявки = ListBoxItem ===== -->
    <Style x:Key="TicketCardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{DynamicResource Layer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="2" RadiusY="2" Fill="{DynamicResource Accent}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-1,0,0,0" Visibility="Collapsed" />
                        <Rectangle x:Name="FocusRing" Stroke="{DynamicResource Focus}" StrokeThickness="2" RadiusX="9" RadiusY="9"
                                   Margin="-2" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding AgeState}" Value="{x:Static m:AgeState.Overdue}">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CriticalFg}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource LayerSolid}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Card" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.10" Color="Black" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Строка заметки (hover) ===== -->
    <Style x:Key="NoteRow" TargetType="Border">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Крестик в строке заметки (виден по наведению на строку) ===== -->
    <Style x:Key="NoteDeleteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CriticalFg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== «Призрачный» TextBox: выглядит как текст, рамка на hover/focus ===== -->
    <Style x:Key="GhostTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Margin" Value="-4,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextTertiary}"
                                       FontSize="{TemplateBinding FontSize}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LayerSolid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
