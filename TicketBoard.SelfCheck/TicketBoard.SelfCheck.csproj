<Project Sdk="Microsoft.NET.Sdk">

  <!-- Самопроверки разборщиков без Windows и без UI: те же исходники, что и в приложении, собранные в консоль.
       Запуск: dotnet run, проект TicketBoard.SelfCheck, только Debug (см. Program.cs и AGENTS.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- DPAPI из AppSettings здесь не вызывается: файл нужен только для компиляции -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../TicketBoard/Services/HttpIntraserviceClient*.cs" />
    <Compile Include="../TicketBoard/Services/IntraserviceLinkParser.cs" />
    <Compile Include="../TicketBoard/Services/AppSettings.cs" />
    <Compile Include="../TicketBoard/Services/ClaudeRelay*.cs" />
    <Compile Include="../TicketBoard/Services/AutoSyncRules.cs" />
    <Compile Include="../TicketBoard/Services/FakeIntraservice.cs" />
    <Compile Include="../TicketBoard/Services/KnowledgeExport*.cs" />
    <Compile Include="../TicketBoard/Services/TaskQuery.cs" />
    <Compile Include="../TicketBoard/Services/TicketSearch.cs" />
    <!-- окно поиска и доска: viewmodel'и как есть, а то, что они берут у WPF-части, — в WpfStubs.cs -->
    <Compile Include="../TicketBoard/ViewModels/SearchViewModel.cs" />
    <Compile Include="../TicketBoard/ViewModels/MainViewModel*.cs" />
    <Compile Include="../TicketBoard/ViewModels/ColumnViewModel.cs" />
    <Compile Include="../TicketBoard/ViewModels/QuickCaptureViewModel.cs" />
    <Compile Include="../TicketBoard/ViewModels/SettingsViewModel.cs" />
    <Compile Include="../TicketBoard/Models/Ticket.cs" />
    <Compile Include="../TicketBoard/Services/TicketStore.cs" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- в приложении ProtectedData приходит с WindowsDesktop; консоли на net10.0 нужен пакет -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
